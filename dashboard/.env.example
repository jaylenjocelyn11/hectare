# Copie ce fichier vers .env (même dossier) puis remplis les 2 champs vides.
#
# Analogie : Firestore = un classeur partagé dans le nuage.
# L’app iPad écrit dedans. Ce site web lit le même classeur.
#
# 1) Console Firebase → https://console.firebase.google.com/
# 2) Projet hectarecafe-e0df2
# 3) Paramètres du projet (engrenage) → Tes applications → Ajouter une appli Web (</>)
#    si tu n’en as pas encore. Copie l’« App ID » (ça ressemble à 1:523047663076:web:xxxx)
# 4) Auth → Utilisateurs → Ajoute un compte e-mail / mot de passe pour te connecter au site
# 5) Firestore → collection dashboardUsers → document = l’UID de ce compte
#    Champ : organizationId  (même ID que l’organisation de l’iPad)

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=hectarecafe-e0df2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hectarecafe-e0df2
VITE_FIREBASE_STORAGE_BUCKET=hectarecafe-e0df2.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=523047663076
VITE_FIREBASE_APP_ID=

# Même base nommée que l’app iOS.
VITE_FIRESTORE_DATABASE_ID=hectarecafe

# Optionnel, seulement pour tester sans dashboardUsers :
VITE_DEV_ORG_ID=

# Ton e-mail Firebase : toi seul peux créer des tableaux de bord (en plus du champ Firestore platformAdmin).
VITE_PLATFORM_ADMIN_EMAIL=
